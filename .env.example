NODE_ENV=development
DATABASE_URL=postgres://mylocalon:mylocalon@localhost:5433/mylocalon
BASE_URL=http://localhost:3001
BASE_DOMAIN=localtest.me
TUNNEL_URL_SCHEME=http
TUNNEL_URL_PORT=7002
JWT_PRIVATE_KEY_PATH=keys/ed25519.key
JWT_KID=k1
# During rotation: old public keys still served via JWKS, e.g. k0=keys-old/ed25519.pub
JWT_EXTRA_PUBLIC_KEYS=
JWT_ISSUER=mylocalon-platform
JWT_AUDIENCE=mylocalon-gateway
JWT_TTL_SECONDS=3600
# Shared with the gateway (ML_INTERNAL_TOKEN). Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-change-me-change-me-change-me
LOG_LEVEL=info
